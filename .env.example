# Copia estos nombres en las "Variables" del servidor. NUNCA pegues los valores en chats.
BOT_TOKEN=token_que_te_da_BotFather
CRYPTOPAY_TOKEN=token_de_tu_app_en_CryptoBot
CRYPTOPAY_TESTNET=true
CHANNEL_ID=-100xxxxxxxxxx
ADMIN_IDS=tu_id_de_telegram
DB_PATH=/data/bot.db   # en tu computadora: bot.db
# Solo para probar con dinero real (1 y 2 USDT). Sin estas líneas cobra 27.77 y 277.77.
# PRICE_MENSUAL=1
# PRICE_ANUAL=2
# Solo para probar en testnet con TRX de prueba. Sin esta línea cobra en USDT.
# PAYMENT_ASSET=TRX
# Acceso a los cursos de la web (opcional). Sin estas dos líneas, el bot solo da el canal.
# WEB_ACCESS_URL=https://vwqivhvhlrzjiqvwnhno.supabase.co/functions/v1/bot-access
# WEB_ACCESS_SECRET=el_mismo_valor_que_BOT_ACCESS_SECRET_en_Supabase
# Opcionales. Comunidad: grupo de Telegram que se entrega a quien paga.
# Soporte: link para que los usuarios te escriban. Sin ellas, esos botones no aparecen.
# COMMUNITY_URL=https://t.me/+link_del_grupo
# SUPPORT_URL=https://t.me/tu_usuario
# Teléfono para consultas y dudas que se muestra en el menú y la ayuda. Sin esta línea usa +1 (551) 332-0026.
# SUPPORT_PHONE=+1 (551) 332-0026
